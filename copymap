    if p3.UserInputType == Enum.UserInputType.MouseButton1
      or p3.UserInputType == Enum.UserInputType.Touch then
      flag3 = true
      position = p3.Position
      position2 = main.Position

      p3.Changed:Connect(function()
        if p3.UserInputState == Enum.UserInputState.End then
          flag3 = false
        end
      end)
    end
  end)

  userInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
      or input.UserInputType == Enum.UserInputType.Touch then
      if not flag3 then
        return
      end

      local udim2 = UDim2
      local v7 = input.Position - position
      local new = udim2.new
      local scale = position2.X.Scale
      local offset = position2.X.Offset
      local x = v7.X
      local scale2 = position2.Y.Scale
      local offset2 = position2.Y.Offset
      local y = v7.Y
      local position3 = new(scale, offset + x, scale2, offset2 + y)
      tweenService:Create(main, TweenInfo.new(p2), { Position = position3 }):Play()
    end
  end)
end

